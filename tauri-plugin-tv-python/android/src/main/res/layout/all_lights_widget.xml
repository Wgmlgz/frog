<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/all_lights_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp"
    android:background="@drawable/widget_off">
    <ImageView
        android:id="@+id/widget_power_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/widget_power"
        android:contentDescription="@string/all_lights_widget_description" />
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:singleLine="true"
        android:text="@string/all_lights_widget_label"
        android:textColor="#F3F4F6"
        android:textSize="10sp"
        android:layout_marginTop="3dp" />
</LinearLayout>
